            ],
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "purpose",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "ref",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Uploads an image using multipart/form-data and returns the stored URL for referencing the image in post or page content."
        }
      ]
    }
  ],
  "bundled": true
