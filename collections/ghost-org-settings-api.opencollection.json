{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ghost Admin Authors Settings API",
    "version": "5.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Settings",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Read settings",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{site}.ghost.io/ghost/api/admin/settings/"
          },
          "docs": "Retrieve all public settings for the Ghost publication, including title, description, logo, icon, cover image, language, timezone, navigation, and other site-wide configuration values."
        }
      ]
    }
  ],
  "bundled": true
}