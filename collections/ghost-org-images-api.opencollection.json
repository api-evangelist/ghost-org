{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ghost Admin Authors Images API",
    "version": "5.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Images",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Upload an image",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{site}.ghost.io/ghost/api/admin/images/upload/",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "purpose",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "ref",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Upload an image file to the Ghost publication. The image is uploaded as multipart form data and the response includes the URL where the image can be accessed."
        }
      ]
    }
  ],
  "bundled": true
}