{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ghost Content and Admin APIs Admin - Images Content - Posts API",
    "version": "5.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "key",
      "value": "{{key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Content - Posts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Browse posts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{admin_domain}/ghost/api/content/posts/",
            "params": [
              {
                "name": "key",
                "value": "",
                "type": "query",
                "description": "Content API key."
              },
              {
                "name": "include",
                "value": "",
                "type": "query",
                "description": "Comma-separated related data to include (for example authors,tags)."
              },
              {
                "name": "fields",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of fields to return."
              },
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "Ghost NQL filter expression."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of records per page (default 15, or 'all')."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number of results to return."
              },
              {
                "name": "order",
                "value": "",
                "type": "query",
                "description": "Sort order, for example 'published_at desc'."
              },
              {
                "name": "formats",
                "value": "",
                "type": "query",
                "description": "Content formats to return, for example 'html,lexical'."
              }
            ]
          },
          "docs": "Returns a paginated list of published posts."
        },
        {
          "info": {
            "name": "Read a post by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{admin_domain}/ghost/api/content/posts/:id/",
            "params": [
              {
                "name": "key",
                "value": "",
                "type": "query",
                "description": "Content API key."
              },
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The resource ID."
              },
              {
                "name": "include",
                "value": "",
                "type": "query",
                "description": "Comma-separated related data to include (for example authors,tags)."
              }
            ]
          },
          "docs": "Read a post by ID"
        },
        {
          "info": {
            "name": "Read a post by slug",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{admin_domain}/ghost/api/content/posts/slug/:slug/",
            "params": [
              {
                "name": "key",
                "value": "",
                "type": "query",
                "description": "Content API key."
              },
              {
                "name": "slug",
                "value": "",
                "type": "path",
                "description": "The resource slug."
              },
              {
                "name": "include",
                "value": "",
                "type": "query",
                "description": "Comma-separated related data to include (for example authors,tags)."
              }
            ]
          },
          "docs": "Read a post by slug"
        }
      ]
    }
  ],
  "bundled": true
}