          "request": {
            "name": "Upload an image",
            "description": {
              "content": "Upload an image file to the Ghost publication. The image is uploaded as multipart form data and the response includes the URL where the image can be accessed.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "images",
                "upload",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Your Ghost site subdomain",
                  "type": "any",
                  "value": "{{site}}",
                  "key": "site"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "description": "(Required) The image file to upload"
                },
                {
                  "key": "purpose",
                  "value": "<string>",
                  "type": "text",
                  "description": "Purpose of the image, such as image, profile_image, or icon (This can only be one of image,profile_image,icon)"
                },
                {
                  "key": "ref",
                  "value": "<string>",
                  "type": "text",
                  "description": "Reference identifier for the image"
                }
              ]
            }
